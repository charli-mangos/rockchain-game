# Copia este fichero a .env y rellénalo con la configuración de TU proyecto Firebase
# (Firebase Console > Configuración del proyecto > Tus apps). No subas .env al repositorio.

EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Servidor Socket.IO (local: ws://localhost:3001, o la IP de tu ordenador en un móvil físico;
# producción: la URL wss:// de tu servicio de Cloud Run)
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:3001

# true para usar los emuladores locales de Firebase
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=localhost
