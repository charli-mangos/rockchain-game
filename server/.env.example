# Variables del servidor Socket.IO (Cloud Run las recibe con --set-env-vars)
PORT=3001
FIREBASE_PROJECT_ID=your-project-id
# Orígenes permitidos para CORS, separados por comas (vacío = solo clientes sin cabecera Origin, p. ej. la app móvil)
CORS_ORIGINS=
# Credenciales: usa ADC o GOOGLE_APPLICATION_CREDENTIALS apuntando a un fichero FUERA del repo
# Nivel de log: debug | info | warn (por defecto warn si NODE_ENV=production)
LOG_LEVEL=
