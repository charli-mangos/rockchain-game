rules_version = '2';

// Reglas de seguridad de RockChain.
// Toda la lógica económica (saldos, productos, rondas, bloques) la escriben
// las Cloud Functions y el servidor Socket.IO con Firebase Admin, que no pasa
// por estas reglas. El cliente solo puede:
//   - crear su perfil y editar su nombre e imagen,
//   - marcar en su propia partida campos no económicos (listo, industria, problemas respondidos),
//   - leer las partidas en las que participa y buscar partidas abiertas por código.
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNCIONES AUXILIARES
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function gameData(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }

    function participatesInGame(gameId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/games/$(gameId)) &&
             (gameData(gameId).hostId == request.auth.uid ||
              request.auth.uid in gameData(gameId).players);
    }

    // Campos de users/{uid}.games.{gameId} que el propio jugador puede modificar
    function clientWritableGameFields() {
      return ['readyForNextRound', 'respondedProblems', 'selectedIndustry'];
    }

    // Actualización de una sola partida, identificada en `lastGameId`,
    // que solo toca campos no económicos de esa partida.
    function isValidOwnGameUpdate() {
      let gid = request.resource.data.lastGameId;
      let before = resource.data.get('games', {});
      let after = request.resource.data.get('games', {});
      return gid is string &&
             before.keys().hasAny([gid]) &&
             after.keys().hasAny([gid]) &&
             after.diff(before).affectedKeys().hasOnly([gid]) &&
             after[gid].diff(before[gid]).affectedKeys().hasOnly(clientWritableGameFields());
    }

    function isValidProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['userName', 'image', 'lastUpdated']) &&
             (!request.resource.data.keys().hasAny(['userName']) ||
              (request.resource.data.userName is string &&
               request.resource.data.userName.size() > 0 &&
               request.resource.data.userName.size() <= 40)) &&
             (!request.resource.data.keys().hasAny(['image']) ||
              (request.resource.data.image is string &&
               request.resource.data.image.size() <= 2048));
    }

    // ============================================
    // COLECCIÓN: users
    // Perfil público (nombre, imagen) y estado de juego. No se guarda el email:
    // ya está en Firebase Auth y así no se expone a otros jugadores.
    // ============================================

    match /users/{userId} {
      // Los rankings y la lista de jugadores leen el perfil y las estadísticas de otros jugadores.
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly(['userId', 'userName', 'image', 'games']) &&
                       request.resource.data.userId == userId &&
                       request.resource.data.userName is string &&
                       request.resource.data.userName.size() > 0 &&
                       request.resource.data.userName.size() <= 40 &&
                       request.resource.data.games == {};

      allow update: if isOwner(userId) && (
        isValidProfileUpdate() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'lastGameId']) &&
         isValidOwnGameUpdate())
      );

      allow delete: if isOwner(userId);
    }

    // ============================================
    // COLECCIÓN: games (solo la escriben las Cloud Functions)
    // ============================================

    match /games/{gameId} {
      // Participantes, o cualquiera autenticado mientras la partida está abierta (unirse por código)
      allow get: if participatesInGame(gameId) ||
                    (isAuthenticated() && resource.data.status == 'waiting');

      // Búsqueda por código: solo partidas abiertas y de una en una
      allow list: if isAuthenticated() &&
                     resource.data.status == 'waiting' &&
                     request.query.limit <= 1;

      allow write: if false;

      match /rounds/{roundId} {
        allow read: if participatesInGame(gameId);
        allow write: if false;
      }

      match /market/{roundId} {
        allow read: if participatesInGame(gameId);
        allow write: if false;
      }
    }

    // ============================================
    // COLECCIÓN: market (legacy)
    // ============================================

    match /market/{gameId} {
      allow read: if participatesInGame(gameId);
      allow write: if false;
    }

    // ============================================
    // COLECCIÓN: blockchain
    // ============================================

    match /blockchain/{gameId} {
      allow read: if participatesInGame(gameId);
      allow write: if false;

      match /blocks/{blockId} {
        allow read: if participatesInGame(gameId);
        allow write: if false;
      }
    }

    // ============================================
    // COLECCIÓN: products (catálogo)
    // ============================================

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // DENEGAR TODO LO DEMÁS
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
